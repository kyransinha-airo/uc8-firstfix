# Copy to backend/.env (gitignored). Every value is optional for the offline tests.

APP_NAME=FirstFix
ENVIRONMENT=local

# PostgreSQL. Local: docker compose -f docker-compose.postgres.yml up -d
# DATABASE_URL=postgresql://poc:poc@localhost:5438/poc
DATABASE_URL=

# Tests only: a role that can CREATE DATABASE, on a maintenance database. Each DB test
# creates and drops its own database. Unset: the DB tests are skipped.
# TEST_ADMIN_URL=postgresql://poc:poc@localhost:5438/postgres
TEST_ADMIN_URL=

# Azure OpenAI (Foundry). An endpoint ending in /v1 needs no API version.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Agent calls: live (call the model), record (call it and save outputs to REPLAY_DIR),
# replay (saved outputs only, no model; for the demo and CI).
LLM_MODE=live
REPLAY_DIR=../data/replay

# Local file storage (relative paths are relative to backend/)
DATA_DIR=../data

# Comma-separated origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3008,http://127.0.0.1:3008
